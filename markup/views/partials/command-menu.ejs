<%
// Opens when the URL hash is #command (CSS :target). In the app, open it with Esc.
const groups = [
    {
        title: "Test",
        items: [
            ["Restart test", ["tab", "enter"]],
            ["Time 15 / 30 / 60 / 120", ["ctrl", "shift", "p"]],
            ["Toggle punctuation", []],
            ["Toggle numbers", []],
        ],
    },
    {
        title: "Go to",
        items: [
            ["Practice drills", []],
            ["Custom text", []],
            ["Leaderboard", []],
            ["History", ["ctrl", "h"]],
            ["Settings", ["ctrl", ","]],
        ],
    },
    { title: "Theme", items: ["system", "dark", "light", "nord", "sepia", "matrix"].map((name) => [name, [], name]) },
];
%>
<div id="command" class="fixed inset-0 z-50 hidden items-start justify-center bg-ink-950/80 p-4 pt-[15vh] backdrop-blur-sm target:flex">
    <a href="#" class="absolute inset-0" aria-label="Close command menu"></a>
    <div class="relative w-full max-w-lg overflow-hidden rounded-xl border border-ink-800 bg-ink-900 shadow-2xl">
        <div class="flex items-center gap-3 border-b border-ink-800 px-4">
            <svg viewBox="0 0 24 24" class="size-4 text-ink-500" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input class="h-12 flex-1 bg-transparent text-sm text-ink-100 outline-none placeholder:text-ink-600" placeholder="Type a command…" />
            <%- include("kbd", { key: "esc" }) %>
        </div>
        <div class="max-h-80 overflow-y-auto p-2">
            <% groups.forEach((group, g) => { %>
            <p class="px-2 pt-2 pb-1 text-xs text-ink-500"><%= group.title %></p>
            <% group.items.forEach(([label, keys, theme], i) => { %>
            <button <% if (theme) { %>data-set-theme="<%= theme %>" <% } %>class="flex w-full items-center justify-between rounded-md px-2 py-2 text-left text-sm <%= g === 0 && i === 0 ? 'bg-ink-800 text-ink-100' : 'text-ink-300 hover:bg-ink-800' %>">
                <%= label %>
                <span class="flex gap-1"><% for (const key of keys) { %><%- include("kbd", { key }) %><% } %></span>
            </button>
            <% }) %>
            <% }) %>
        </div>
        <div class="flex gap-4 border-t border-ink-800 px-4 py-2 text-xs text-ink-500">
            <span class="flex items-center gap-1"><%- include("kbd", { key: "↑" }) %><%- include("kbd", { key: "↓" }) %> move</span>
            <span class="flex items-center gap-1"><%- include("kbd", { key: "enter" }) %> select</span>
        </div>
    </div>
</div>
