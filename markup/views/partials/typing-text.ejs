<%#
    The typing text. Each word is a <span>; each letter inside is coloured by state:
      untyped    text-ink-600
      correct    text-ink-100
      wrong      text-rose-500 + underline
      extra      text-rose-500/60 (typed past the end of a word)
    The current word gets a subtle background. Three lines show; the last fades out.
    Pass `size` to change the text size (default text-[1.75rem]).
%>
<%
// Sample state: words already typed (with per-letter result), the current word, and words still to come.
const typed = [
    [["the", "ok"]],
    [["quick", "ok"]],
    [["br", "ok"], ["i", "bad"], ["wn", "ok"]],
    [["fox", "ok"]],
    [["jumps", "ok"], ["s", "extra"]],
    [["over", "ok"]],
];
const current = { done: "th", rest: "e" };
const upcoming = "lazy dog while every keystroke is checked one character at a time so you can see exactly where your fingers slip and how your speed holds up over the full test".split(" ");
const letterClass = { ok: "text-ink-100", bad: "text-rose-500 underline decoration-rose-500/60 underline-offset-[6px]", extra: "text-rose-500/60" };
%>
<div class="max-h-[7.5rem] overflow-hidden font-mono <%= locals.size ?? 'text-[1.75rem]' %> leading-[2.5rem] text-ink-600 transition select-none [mask-image:linear-gradient(to_bottom,black_70%,transparent)] group-[.unfocused]:opacity-30 group-[.unfocused]:blur-[3px]">
    <% for (const word of typed) { %><span class="mr-[0.6ch] inline-block"><% for (const [text, state] of word) { %><span class="<%= letterClass[state] %>"><%= text %></span><% } %></span><% } %><span class="relative mr-[0.6ch] inline-block rounded-md bg-ink-800/50 px-0.5 -mx-0.5"><span class="text-ink-100"><%= current.done %></span><span class="caret absolute top-1 h-[1.15em] w-0.5 rounded-full bg-primary" style="left: calc(<%= current.done.length %>ch + 0.125rem)"></span><%= current.rest %></span><% for (const w of upcoming) { %><span class="mr-[0.6ch] inline-block"><%= w %></span><% } %>
</div>
