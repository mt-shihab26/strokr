<%# Full strokr logo: mark + wordmark in one SVG. Uses theme colours. Pass `size` (Tailwind classes, set the height). %>
<svg viewBox="0 0 110 32" class="<%= locals.size ?? 'h-8 w-auto' %>" role="img" aria-label="strokr">
    <g class="origin-[16px_16px] transition group-hover:rotate-[-8deg]">
        <rect width="32" height="32" rx="9" fill="var(--accent)" />
        <rect x="3" y="3" width="26" height="23" rx="7" fill="#fff" fill-opacity="0.18" />
        <g stroke="var(--ink-950)" stroke-linecap="round" stroke-width="2.4">
            <path d="M7.5 11.5h7" />
            <path d="M9.5 16h5" stroke-opacity="0.75" />
            <path d="M11.5 20.5h3" stroke-opacity="0.5" />
        </g>
        <rect x="18.5" y="8.5" width="3" height="15" rx="1.5" fill="var(--ink-950)" />
    </g>
    <text x="41" y="22.5" font-family="JetBrains Mono, ui-monospace, monospace" font-size="21" font-weight="800" letter-spacing="-1.4" fill="var(--ink-100)">strok<tspan fill="var(--accent)">r</tspan></text>
    <rect class="caret" x="105" y="8" width="2.5" height="17" rx="1.25" fill="var(--accent)" />
</svg>
