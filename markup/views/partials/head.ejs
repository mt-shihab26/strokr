<%
// Themes. Each one sets the 11-step "ink" scale (950 = page background, 100 = brightest text)
// and the accent colour. Add a theme by adding an entry here; every page picks it up.
const themes = {
    dark: {
        accent: "oklch(0.82 0.16 80)",
        ink: [0.985, 0.967, 0.92, 0.871, 0.705, 0.552, 0.442, 0.37, 0.274, 0.21, 0.141],
        hue: 286, chroma: 0.008,
    },
    light: {
        accent: "oklch(0.66 0.17 65)",
        ink: [0.141, 0.21, 0.274, 0.37, 0.442, 0.552, 0.705, 0.871, 0.92, 0.967, 0.995],
        hue: 286, chroma: 0.008,
    },
    nord: {
        accent: "oklch(0.78 0.1 210)",
        ink: [0.97, 0.94, 0.9, 0.85, 0.74, 0.62, 0.5, 0.42, 0.36, 0.31, 0.26],
        hue: 255, chroma: 0.03,
    },
    sepia: {
        accent: "oklch(0.58 0.14 40)",
        ink: [0.22, 0.28, 0.34, 0.4, 0.48, 0.58, 0.68, 0.8, 0.88, 0.93, 0.96],
        hue: 75, chroma: 0.03,
    },
    matrix: {
        accent: "oklch(0.85 0.22 145)",
        ink: [0.95, 0.9, 0.85, 0.78, 0.66, 0.54, 0.43, 0.34, 0.26, 0.2, 0.14],
        hue: 150, chroma: 0.05,
    },
};
const steps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const vars = (t) => [`--accent: ${t.accent};`, ...t.ink.map((l, i) => `--ink-${steps[i]}: oklch(${l} ${t.chroma} ${t.hue});`)].join(" ");
%>
<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><%= title %> — strokr</title>
        <link rel="icon" type="image/svg+xml" href="favicon.svg" />
        <link rel="sitemap" type="application/xml" href="sitemap.xml" />
        <script>
            // Apply the saved theme before the page paints, and wire up every [data-set-theme] button.
            const applyTheme = (name) => {
                const resolved = name === "system" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") : name;
                document.documentElement.dataset.theme = resolved;
                document.documentElement.dataset.themeChoice = name;
            };
            applyTheme(localStorage.getItem("theme") ?? "dark");
            document.addEventListener("click", (event) => {
                const button = event.target.closest("[data-set-theme]");
                if (!button) return;
                localStorage.setItem("theme", button.dataset.setTheme);
                applyTheme(button.dataset.setTheme);
            });
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
        <style>
            <% for (const [name, theme] of Object.entries(themes)) { %>
            [data-theme="<%= name %>"] { <%= vars(theme) %> }
            <% } %>
        </style>
        <style type="text/tailwindcss">
            @theme inline {
                --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
                --font-mono: "JetBrains Mono", ui-monospace, monospace;
                --color-accent: var(--accent);
                <% for (const step of steps) { %>--color-ink-<%= step %>: var(--ink-<%= step %>);
                <% } %>
            }
            /* Highlight the active option in any theme picker. */
            <% for (const name of [...Object.keys(themes), "system"]) { %>
            [data-theme-choice="<%= name %>"] [data-set-theme="<%= name %>"] {
                @apply border-accent text-accent;
            }
            <% } %>
            /* ---------- Polish ---------- */
            @layer base {
                html {
                    scroll-behavior: smooth;
                }
                ::selection {
                    background: color-mix(in oklab, var(--accent) 35%, transparent);
                }
                :focus-visible {
                    outline: 2px solid var(--accent);
                    outline-offset: 2px;
                    border-radius: 0.375rem;
                }
                a,
                button,
                summary,
                input,
                textarea {
                    transition-property: color, background-color, border-color, box-shadow, transform, opacity;
                    transition-duration: 150ms;
                    transition-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
                }
                button:active,
                a:active,
                summary:active {
                    transform: scale(0.97);
                }
            }

            /* ---------- Motion (CSS only, no JS, no extra requests) ---------- */
            @keyframes rise {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
            }
            @keyframes pop {
                from {
                    opacity: 0;
                    transform: translateY(-6px) scale(0.98);
                }
            }
            @keyframes fade {
                from {
                    opacity: 0;
                }
            }
            @keyframes grow {
                from {
                    transform: scaleX(0);
                }
            }
            @keyframes draw {
                from {
                    stroke-dashoffset: 1;
                }
            }
            @keyframes blink {
                50% {
                    opacity: 0;
                }
            }

            /* Page sections rise in one after another. */
            main > * {
                animation: rise 450ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
            }
            <% for (let i = 2; i <= 8; i++) { %>main > :nth-child(<%= i %>) { animation-delay: <%= (i - 1) * 50 %>ms; }
            <% } %>

            /* Items inside a grid or list ripple in. Add .stagger to the parent. */
            .stagger > * {
                animation: rise 400ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
            }
            <% for (let i = 1; i <= 12; i++) { %>.stagger > :nth-child(<%= i %>) { animation-delay: <%= 150 + i * 35 %>ms; }
            <% } %>

            .lift {
                @apply transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/10;
            }
            .bar {
                transform-origin: left;
                animation: grow 900ms 250ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
            }
            .draw {
                stroke-dasharray: 1;
                animation: draw 1.2s 200ms cubic-bezier(0.4, 0, 0.2, 1) both;
            }
            .caret {
                animation: blink 1s step-end infinite;
            }
            #command:target {
                animation: fade 150ms ease-out both;
            }
            #command:target > div {
                animation: pop 180ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
            }
            details[open] > div {
                animation: pop 150ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
            }

            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation: none !important;
                    transition: none !important;
                    scroll-behavior: auto !important;
                }
            }
        </style>
    </head>
    <body class="min-h-screen bg-ink-950 font-sans text-ink-300 antialiased transition-colors">
        <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6">
