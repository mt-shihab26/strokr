<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><%= title %> — strokr</title>
        <%
        const og = {
            title: `${title} — strokr`,
            description: "A keyboard-first typing speed trainer with per-character feedback, charts and history.",
            image: "https://strokr.app/og.png",
            ...locals.og,
        };
        %>
        <meta name="description" content="<%= og.description %>" />
        <meta property="og:site_name" content="strokr" />
        <meta property="og:title" content="<%= og.title %>" />
        <meta property="og:description" content="<%= og.description %>" />
        <meta property="og:image" content="<%= og.image %>" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <link id="favicon" rel="icon" type="image/svg+xml" href="favicon.svg" />
        <link rel="sitemap" type="application/xml" href="sitemap.xml" />
        <script>
            // Apply the saved theme before the page paints, and wire up every [data-set-theme] button.
            // Redraw the favicon in the current theme's accent and background colours.
            const updateFavicon = () => {
                const style = getComputedStyle(document.documentElement);
                const accent = style.getPropertyValue("--primary").trim();
                const ink = style.getPropertyValue("--ink-950").trim();
                if (!accent) return;
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="9" fill="${accent}"/><g stroke="${ink}" stroke-linecap="round" stroke-width="3"><path d="M6.5 11h8"/><path d="M9 16.5h5.5" stroke-opacity="0.7"/></g><rect x="18.5" y="7" width="3.5" height="18" rx="1.75" fill="${ink}"/></svg>`;
                document.getElementById("favicon").href = `data:image/svg+xml,${encodeURIComponent(svg)}`;
            };
            const applyTheme = (name) => {
                const resolved = name === "system" ? (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark") : name;
                document.documentElement.dataset.theme = resolved;
                document.documentElement.dataset.themeChoice = name;
                updateFavicon();
            };
            applyTheme(localStorage.getItem("theme") ?? "dark");
            // Theme colours are defined further down the head, so draw the favicon again once they exist.
            document.addEventListener("DOMContentLoaded", updateFavicon);
            // Command menu: ctrl/⌘ + k, "/" or esc opens it; esc closes it.
            document.addEventListener("keydown", (event) => {
                const open = location.hash === "#command";
                const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName) && !open;
                if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
                    event.preventDefault();
                    location.hash = open ? "" : "command";
                } else if (event.key === "Escape") {
                    // Close whatever overlay is open (shortcuts, confirm dialog, command menu); otherwise open the menu.
                    const overlay = location.hash && document.querySelector(`${location.hash}.fixed`);
                    location.hash = open || overlay ? "" : "command";
                } else if (event.key === "/" && !typing && !open) {
                    event.preventDefault();
                    location.hash = "command";
                } else if (event.key === "?" && !typing) {
                    location.hash = location.hash === "#shortcuts-help" ? "" : "shortcuts-help";
                } else if (event.key.toLowerCase() === "f" && !typing && !event.ctrlKey && !event.metaKey) {
                    document.body.classList.toggle("focus-mode");
                }
            });
            // Focus the search field whenever the menu opens.
            addEventListener("hashchange", () => {
                if (location.hash === "#command") document.querySelector("#command input")?.focus();
            });
            document.addEventListener("click", (event) => {
                const button = event.target.closest("[data-set-theme]");
                if (!button) return;
                localStorage.setItem("theme", button.dataset.setTheme);
                applyTheme(button.dataset.setTheme);
            });
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
            rel="stylesheet"
        />
        <!-- Built locally with the Tailwind CLI from markup/main.css (themes and motion shared with the app). -->
        <link rel="stylesheet" href="main.css" />
    </head>
    <body class="min-h-screen bg-ink-950 font-sans text-ink-300 antialiased">
        <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6">
