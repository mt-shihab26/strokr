<%
// On-screen keyboard.
//   heat:   { key: 0..1 } colours keys by error rate (red = more misses)
//   active: a key to highlight as "press next"
//   fingers: true colours keys by the finger that should press them
const rows = [
    ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
    ["a", "s", "d", "f", "g", "h", "j", "k", "l", ";"],
    ["z", "x", "c", "v", "b", "n", "m", ",", ".", "/"],
];
const heat = locals.heat ?? {};
const active = locals.active;
const fingers = locals.fingers ?? false;
const fingerColour = ["bg-rose-500/20", "bg-orange-500/20", "bg-amber-500/20", "bg-lime-500/20", "bg-lime-500/20", "bg-sky-500/20", "bg-sky-500/20", "bg-violet-500/20", "bg-fuchsia-500/20", "bg-pink-500/20"];
const keyClass = (key, col) => {
    if (key === active) return "bg-accent text-ink-950 ring-2 ring-accent/40";
    if (key in heat) {
        const v = heat[key];
        return v > 0.6 ? "bg-rose-500/70 text-white" : v > 0.3 ? "bg-rose-500/35 text-ink-100" : "bg-rose-500/15 text-ink-200";
    }
    if (fingers) return `${fingerColour[col]} text-ink-200`;
    return "bg-ink-900 text-ink-400";
};
%>
<div class="flex flex-col items-center gap-1.5 font-mono text-sm select-none">
    <% rows.forEach((row, r) => { %>
    <div class="flex gap-1.5" style="margin-left: <%= r * 0.75 %>rem">
        <% row.forEach((key, col) => { %>
        <span class="grid size-10 place-items-center rounded-md border border-ink-800 <%= keyClass(key, col) %> <%= ['f', 'j'].includes(key) ? 'underline underline-offset-4' : '' %>"><%= key %></span>
        <% }) %>
    </div>
    <% }) %>
    <span class="mt-1 grid h-10 w-72 place-items-center rounded-md border border-ink-800 <%= active === 'space' ? 'bg-accent text-ink-950' : 'bg-ink-900 text-ink-500' %>">space</span>
</div>
