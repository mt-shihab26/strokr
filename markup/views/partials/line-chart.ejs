<%
// Simple SVG line chart. Pass: series = [{ values, color, label }], height (px), max (y-axis max).
const width = 600;
const h = locals.height ?? 200;
const maxY = locals.max ?? 120;
const count = series[0].values.length;
const x = (i) => (i / (count - 1)) * width;
const y = (v) => h - (v / maxY) * h;
%>
<div>
    <svg viewBox="0 0 <%= width %> <%= h %>" class="h-auto w-full overflow-visible" preserveAspectRatio="none">
        <% for (const t of [0.25, 0.5, 0.75, 1]) { %>
        <line x1="0" x2="<%= width %>" y1="<%= h - t * h %>" y2="<%= h - t * h %>" class="stroke-ink-800" stroke-dasharray="4 4" />
        <% } %>
        <% for (const s of series) { %>
        <polyline
           
            pathLength="1"
            fill="none"
            stroke="<%= s.color %>"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
            points="<%= s.values.map((v, i) => `${x(i)},${y(v)}`).join(' ') %>"
        />
        <% } %>
    </svg>
    <div class="mt-3 flex gap-4 text-xs text-ink-500">
        <% for (const s of series) { %>
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full" style="background: <%= s.color %>"></span><%= s.label %></span>
        <% } %>
    </div>
</div>
