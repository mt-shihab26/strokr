<label class="flex flex-col gap-1.5">
    <span class="flex items-center justify-between text-sm text-ink-300">
        <%= label %>
        <% if (locals.aside) { %><a href="<%= locals.asideHref ?? "#" %>" class="text-xs text-ink-500 hover:text-primary"><%= aside %></a><% } %>
    </span>
    <input
        type="<%= locals.type ?? 'text' %>"
        placeholder="<%= locals.placeholder ?? '' %>"
        class="h-10 rounded-md border <%= locals.error ? 'border-rose-700' : 'border-ink-800' %> bg-ink-950 px-3 text-sm text-ink-100 outline-none placeholder:text-ink-600 focus:border-primary"
    />
    <% if (locals.error) { %><span class="text-xs text-rose-400"><%= error %></span><% } %>
</label>
