<%
const links = [
    { href: "index.html", label: "Test", page: "index" },
    { href: "practice.html", label: "Practice", page: "practice" },
    { href: "custom.html", label: "Custom", page: "custom" },
    { href: "leaderboard.html", label: "Leaderboard", page: "leaderboard" },
    { href: "history.html", label: "History", page: "history" },
    { href: "settings.html", label: "Settings", page: "settings" },
];
%>
<header class="flex flex-wrap items-center justify-between gap-4 py-8">
    <a href="index.html" class="flex items-center gap-2 font-mono text-xl font-bold text-ink-100">
        <span class="grid size-8 place-items-center rounded-md bg-accent text-sm text-ink-950">s</span>
        strokr
    </a>
    <nav class="flex flex-wrap items-center gap-1 text-sm">
        <% for (const link of links) { %>
        <a
            href="<%= link.href %>"
            class="rounded-md px-3 py-1.5 <%= link.page === page ? 'bg-ink-900 text-ink-100' : 'text-ink-500 hover:bg-ink-900 hover:text-ink-200' %>"
        ><%= link.label %></a>
        <% } %>
    </nav>
    <div class="flex items-center gap-2">
        <!-- Theme selector -->
        <details class="group relative">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-ink-800 px-2.5 py-1.5 text-xs text-ink-500 hover:text-ink-200">
                <span class="size-3 rounded-full bg-accent"></span>
                Theme
                <svg viewBox="0 0 24 24" class="size-3 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="absolute right-0 z-40 mt-2 w-44 rounded-lg border border-ink-800 bg-ink-900 p-1 shadow-xl">
                <% for (const name of ["system", "dark", "light", "nord", "sepia", "matrix"]) { %>
                <button data-set-theme="<%= name %>" class="flex w-full items-center gap-2 rounded-md border border-transparent px-2 py-1.5 text-left text-sm text-ink-300 hover:bg-ink-800">
                    <span data-theme="<%= name === 'system' ? 'dark' : name %>" class="flex gap-0.5 rounded bg-ink-950 p-1">
                        <span class="size-2 rounded-full bg-accent"></span>
                        <span class="size-2 rounded-full bg-ink-100"></span>
                        <span class="size-2 rounded-full bg-ink-600"></span>
                    </span>
                    <%= name %>
                </button>
                <% } %>
            </div>
        </details>
        <a href="#command" class="flex items-center gap-2 rounded-md border border-ink-800 px-2.5 py-1.5 text-xs text-ink-500 hover:text-ink-200">
            Search <%- include("kbd", { key: "esc" }) %>
        </a>
        <a href="profile.html" class="grid size-8 place-items-center rounded-full bg-ink-800 font-mono text-xs text-ink-200 <%= page === 'profile' ? 'ring-2 ring-accent' : '' %>" aria-label="Profile">SM</a>
    </div>
</header>
<%- include("command-menu") %>
