<%
const links = [
    { href: "leaderboard.html", label: "Leaderboard", page: "leaderboard", icon: "trophy" },
    { href: "index.html", label: "Typing test", page: "index", icon: "keyboard" },
    { href: "practice.html", label: "Practice", page: "practice", icon: "target" },
    { href: "custom.html", label: "Custom text", page: "custom", icon: "text" },
    { href: "race.html", label: "Race", page: "race", icon: "flag" },
    { href: "history.html", label: "History", page: "history", icon: "history" },
    { href: "settings.html", label: "Settings", page: "settings", icon: "settings" },
];

// Tooltip shown under an icon button on hover or keyboard focus.
const tip = (label) =>
    `<span role="tooltip" class="pointer-events-none absolute top-full left-1/2 z-50 mt-2 -translate-x-1/2 translate-y-1 rounded-md border border-ink-800 bg-ink-900 px-2 py-1 text-xs whitespace-nowrap text-ink-100 opacity-0 shadow-lg group-hover/tip:translate-y-0 group-hover/tip:opacity-100 group-focus-visible/tip:translate-y-0 group-focus-visible/tip:opacity-100">${label}</span>`;

const themeNames = ["system", "dark", "light", "nord", "sepia", "tokyo-night", "matrix"];

// Command menu (opens when the URL hash is #command). Items: [label, keys, theme to switch to].
const commandGroups = [
    {
        title: "Test",
        items: [
            ["Restart test", ["tab", "enter"]],
            ["Time 15 / 30 / 60 / 120", ["ctrl", "shift", "p"]],
            ["Toggle punctuation", []],
            ["Toggle numbers", []],
        ],
    },
    {
        title: "Go to",
        items: [
            ["Practice drills", []],
            ["Custom text", []],
            ["Leaderboard", []],
            ["History", ["ctrl", "h"]],
            ["Settings", ["ctrl", ","]],
        ],
    },
    { title: "Theme", items: themeNames.map((name) => [name, [], name]) },
];

// Keyboard shortcuts overlay (opens on "?" or #shortcuts-help). Items: [keys, action].
const shortcutGroups = [
    { title: "Test", items: [[["tab", "enter"], "Restart test"], [["esc"], "Command menu"], [["ctrl", "shift", "p"], "Change mode"], [["ctrl", "backspace"], "Delete word"]] },
    { title: "Navigate", items: [[["ctrl", "k"], "Search"], [["g", "t"], "Typing test"], [["g", "p"], "Practice"], [["g", "h"], "History"], [["g", "l"], "Leaderboard"], [["ctrl", ","], "Settings"]] },
    { title: "Results", items: [[["tab"], "Next test"], [["r"], "Repeat test"], [["s"], "Share result"]] },
    { title: "General", items: [[["?"], "This list"], [["f"], "Focus mode"], [["t"], "Cycle theme"]] },
];
%>
<a href="#main" class="fixed top-3 left-3 z-[60] -translate-y-20 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-ink-950 shadow-lg focus:translate-y-0">Skip to content</a>
<header class="sticky top-0 z-30 -mx-6 mb-4 px-6 py-4 backdrop-blur-md">
    <div class="flex items-center justify-between gap-4 rounded-2xl border border-ink-900 bg-ink-950/70 px-3 py-2 shadow-sm shadow-black/5">
        <!-- Logo: the mark on small screens, the full logo from sm up -->
        <a href="index.html" aria-label="strokr home" class="group flex items-center rounded-lg px-1.5 py-1">
            <span class="sm:hidden">
                <svg viewBox="0 0 32 32" class="size-8" role="img" aria-label="strokr">
                    <rect width="32" height="32" rx="9" fill="var(--primary)" />
                    <rect x="3" y="3" width="26" height="23" rx="7" fill="#fff" fill-opacity="0.18" />
                    <g stroke="var(--ink-950)" stroke-linecap="round">
                        <path d="M7.5 11.5h7" stroke-width="2.4" />
                        <path d="M9.5 16h5" stroke-width="2.4" stroke-opacity="0.75" />
                        <path d="M11.5 20.5h3" stroke-width="2.4" stroke-opacity="0.5" />
                    </g>
                    <rect x="18.5" y="8.5" width="3" height="15" rx="1.5" fill="var(--ink-950)" />
                </svg>
            </span>
            <span class="hidden sm:block"><%- include("logo-wide") %></span>
        </a>

        <!-- Icon nav -->
        <nav class="flex items-center gap-0.5 rounded-xl bg-ink-900/60 p-1" aria-label="Main">
            <% for (const link of links) { const active = link.page === page; %>
            <a
                href="<%= link.href %>"
                aria-label="<%= link.label %>"
                <% if (active) { %>aria-current="page"<% } %>
                class="group/tip relative grid size-9 place-items-center rounded-lg <%= active ? 'bg-ink-800 text-primary shadow-sm' : 'text-ink-500 hover:bg-ink-800/60 hover:text-ink-100' %>"
            >
                <span class="icon size-[18px]" style="--icon: url(icons/<%= link.icon %>.svg)"></span>
                <% if (active) { %><span class="absolute -bottom-0.5 h-0.5 w-4 rounded-full bg-primary"></span><% } %>
                <%- tip(link.label) %>
            </a>
            <% } %>
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-1">
            <a href="#command" aria-label="Search (ctrl + k)" aria-keyshortcuts="Control+K" class="group/tip relative grid size-9 place-items-center rounded-lg text-ink-500 hover:bg-ink-900 hover:text-ink-100">
                <span class="icon size-[18px]" style="--icon: url(icons/search.svg)"></span>
                <%- tip(`<span class="flex items-center gap-2">Search <span class="flex gap-0.5 font-mono text-[10px]"><kbd class="rounded border border-ink-700 bg-ink-800 px-1 text-ink-300">ctrl</kbd><kbd class="rounded border border-ink-700 bg-ink-800 px-1 text-ink-300">k</kbd></span></span>`) %>
            </a>

            <!-- Theme picker. Buttons use data-set-theme, handled by the script in head.ejs. -->
            <details class="group relative">
                <summary aria-label="Theme" class="group/tip relative grid size-9 cursor-pointer list-none place-items-center rounded-lg text-ink-500 hover:bg-ink-900 hover:text-ink-100 group-open:bg-ink-900 group-open:text-primary">
                    <span class="icon size-[18px]" style="--icon: url(icons/palette.svg)"></span>
                    <span role="tooltip" class="pointer-events-none absolute top-full left-1/2 z-50 mt-2 -translate-x-1/2 translate-y-1 rounded-md border border-ink-800 bg-ink-900 px-2 py-1 text-xs whitespace-nowrap text-ink-100 opacity-0 shadow-lg group-hover/tip:translate-y-0 group-hover/tip:opacity-100 group-open:hidden">Theme</span>
                </summary>
                <div class="absolute right-0 z-40 mt-2 w-44 rounded-xl border border-ink-800 bg-ink-900 p-1 shadow-xl">
                    <% for (const name of themeNames) { %>
                    <button data-set-theme="<%= name %>" class="flex w-full items-center gap-2 rounded-lg border border-transparent px-2 py-1.5 text-left text-sm text-ink-300 hover:bg-ink-800">
                        <span data-theme="<%= name === 'system' ? 'dark' : name %>" class="flex gap-0.5 rounded bg-ink-950 p-1">
                            <span class="size-2 rounded-full bg-primary"></span>
                            <span class="size-2 rounded-full bg-ink-100"></span>
                            <span class="size-2 rounded-full bg-ink-600"></span>
                        </span>
                        <%= name %>
                    </button>
                    <% } %>
                </div>
            </details>

            <span class="mx-1 h-6 w-px bg-ink-800"></span>

            <a href="profile.html" aria-label="Profile" class="group/tip relative grid size-9 place-items-center rounded-full bg-gradient-to-br from-primary/80 to-ink-700 font-mono text-xs font-bold text-ink-950 ring-2 ring-offset-2 ring-offset-ink-950 <%= page === 'profile' ? 'ring-primary' : 'ring-transparent hover:ring-ink-700' %>">
                SM
                <%- tip("Profile") %>
            </a>
        </div>
    </div>
</header>

<!-- Command menu: opens when the URL hash is #command (ctrl + k, / or esc). -->
<div id="command" class="fixed inset-0 z-50 hidden items-start justify-center bg-ink-950/80 p-4 pt-[15vh] backdrop-blur-sm target:flex">
    <a href="#" class="absolute inset-0" aria-label="Close command menu"></a>
    <div class="relative w-full max-w-lg overflow-hidden rounded-xl border border-ink-800 bg-ink-900 shadow-2xl">
        <div class="flex items-center gap-3 border-b border-ink-800 px-4">
            <span class="icon size-4 text-ink-500" style="--icon: url(icons/search.svg)"></span>
            <input class="h-12 flex-1 bg-transparent text-sm text-ink-100 outline-none placeholder:text-ink-600" placeholder="Type a command…" />
            <%- include("kbd", { key: "esc" }) %>
        </div>
        <div class="max-h-80 overflow-y-auto p-2">
            <% commandGroups.forEach((group, g) => { %>
            <p class="px-2 pt-2 pb-1 text-xs text-ink-500"><%= group.title %></p>
            <% group.items.forEach(([label, keys, theme], i) => { %>
            <button <% if (theme) { %>data-set-theme="<%= theme %>" <% } %>class="flex w-full items-center justify-between rounded-md px-2 py-2 text-left text-sm <%= g === 0 && i === 0 ? 'bg-ink-800 text-ink-100' : 'text-ink-300 hover:bg-ink-800' %>">
                <%= label %>
                <span class="flex gap-1"><% for (const key of keys) { %><%- include("kbd", { key }) %><% } %></span>
            </button>
            <% }) %>
            <% }) %>
        </div>
        <div class="flex gap-4 border-t border-ink-800 px-4 py-2 text-xs text-ink-500">
            <span class="flex items-center gap-1"><%- include("kbd", { key: "↑" }) %><%- include("kbd", { key: "↓" }) %> move</span>
            <span class="flex items-center gap-1"><%- include("kbd", { key: "enter" }) %> select</span>
        </div>
    </div>
</div>

<!-- Keyboard shortcuts overlay: opens on "?" or #shortcuts-help. -->
<div id="shortcuts-help" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink-950/80 p-4 backdrop-blur-sm target:flex">
    <a href="#" class="absolute inset-0" aria-label="Close shortcuts"></a>
    <div class="relative w-full max-w-2xl rounded-2xl border border-ink-800 bg-ink-900 p-6 shadow-2xl">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-lg font-medium text-ink-100">Keyboard shortcuts</h2>
            <a href="#" class="flex items-center gap-1.5 text-xs text-ink-500 hover:text-ink-200">close <%- include("kbd", { key: "esc" }) %></a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
            <% for (const group of shortcutGroups) { %>
            <section>
                <h3 class="mb-2 text-xs font-medium tracking-wider text-ink-500 uppercase"><%= group.title %></h3>
                <ul class="flex flex-col gap-1">
                    <% for (const [keys, action] of group.items) { %>
                    <li class="flex items-center justify-between rounded-lg px-2 py-1.5 text-sm hover:bg-ink-800/50">
                        <span class="text-ink-300"><%= action %></span>
                        <span class="flex gap-1"><% for (const key of keys) { %><%- include("kbd", { key }) %><% } %></span>
                    </li>
                    <% } %>
                </ul>
            </section>
            <% } %>
        </div>
    </div>
</div>
