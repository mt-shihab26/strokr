    { href: "index.html", label: "Test", page: "index" },
    { href: "history.html", label: "History", page: "history" },
    { href: "settings.html", label: "Settings", page: "settings" },
];
%>
<header class="flex items-center justify-between py-8">
    <a href="index.html" class="flex items-center gap-2 font-mono text-xl font-bold text-zinc-100">
        <span class="grid size-8 place-items-center rounded-md bg-accent text-sm text-zinc-950">s</span>
        strokr
    </a>
    <nav class="flex items-center gap-1 text-sm">
        <% for (const link of links) { %>
        <a
