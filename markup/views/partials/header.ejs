            class="rounded-md px-3 py-1.5 <%= link.page === page ? 'bg-zinc-900 text-zinc-100' : 'text-zinc-500 hover:bg-zinc-900 hover:text-zinc-200' %>"
        ><%= link.label %></a>
        <% } %>
    </nav>
</header>
