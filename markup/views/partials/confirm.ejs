<%#
    "Are you sure?" dialog. Opens when the URL hash matches `id` (link to it with href="#<id>").
    Pass: id, title, body, confirm (button label), danger (bool, default true), typeToConfirm (optional word).
%>
<% const danger = locals.danger ?? true; %>
<div id="<%= id %>" role="alertdialog" aria-labelledby="<%= id %>-title" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink-950/80 p-4 backdrop-blur-sm target:flex">
    <a href="#" class="absolute inset-0" aria-label="Cancel"></a>
    <div class="relative w-full max-w-md rounded-2xl border border-ink-800 bg-ink-900 p-6 shadow-2xl">
        <div class="flex gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-full <%= danger ? 'bg-rose-500/15 text-rose-400' : 'bg-accent/15 text-accent' %>">!</span>
            <div>
                <h2 id="<%= id %>-title" class="font-medium text-ink-100"><%= title %></h2>
                <p class="mt-1 text-sm text-ink-400"><%= body %></p>
            </div>
        </div>
        <% if (locals.typeToConfirm) { %>
        <label class="mt-5 flex flex-col gap-1.5 text-sm text-ink-400">
            <span>Type <span class="font-mono text-ink-100"><%= typeToConfirm %></span> to confirm</span>
            <input class="h-10 rounded-lg border border-ink-800 bg-ink-950 px-3 font-mono text-sm text-ink-100 outline-none focus:border-rose-500" autocomplete="off" />
        </label>
        <% } %>
        <div class="mt-6 flex justify-end gap-2">
            <a href="#" class="rounded-lg border border-ink-800 px-4 py-2 text-sm text-ink-300 hover:bg-ink-800">Cancel</a>
            <button class="rounded-lg px-4 py-2 text-sm font-medium <%= danger ? 'bg-rose-600 text-white hover:bg-rose-500' : 'bg-accent text-ink-950 hover:opacity-90' %>"><%= confirm %></button>
        </div>
    </div>
</div>
