<%# Layout for text pages (about, privacy, terms). Pass: kicker, heading, updated, sections = [{ title, body: [paragraphs] }] %>
<main id="main" class="flex flex-1 flex-col gap-10 pb-16">
    <%- include("info-tabs") %>
    <div class="max-w-2xl">
        <p class="font-mono text-xs text-primary"><%= kicker %></p>
        <h1 class="mt-2 text-3xl font-semibold text-ink-100"><%= heading %></h1>
        <% if (locals.updated) { %><p class="mt-2 text-sm text-ink-500">Last updated <%= updated %></p><% } %>
    </div>
    <div class="grid items-start gap-10 lg:grid-cols-[12rem_1fr]">
        <nav class="hidden flex-col gap-1 text-sm lg:sticky lg:top-28 lg:flex">
            <% sections.forEach((s, i) => { %>
            <a href="#s<%= i %>" class="rounded-lg px-3 py-1.5 text-ink-500 hover:bg-ink-900 hover:text-ink-200"><%= s.title %></a>
            <% }) %>
        </nav>
        <article class="flex max-w-2xl flex-col gap-8">
            <% sections.forEach((s, i) => { %>
            <section id="s<%= i %>" class="scroll-mt-28">
                <h2 class="text-lg font-medium text-ink-100"><%= s.title %></h2>
                <% for (const p of s.body) { %><p class="mt-3 leading-relaxed text-ink-400"><%- p %></p><% } %>
            </section>
            <% }) %>
        </article>
    </div>
</main>
