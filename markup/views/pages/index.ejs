<%- include("../partials/head", { title: "Typing test" }) %>
<%- include("../partials/header") %>

<main id="main" class="flex flex-1 flex-col justify-center gap-10 pb-16">
    <%- include("../partials/mobile-notice") %>

    <!-- Mode bar -->
    <div data-hide-in-focus class="mx-auto hidden flex-wrap items-center gap-1 rounded-lg bg-ink-900 p-1 font-mono text-sm md:flex">
        <button class="rounded-md px-3 py-1 text-accent">time</button>
        <button class="rounded-md px-3 py-1 text-ink-500 hover:text-ink-200">words</button>
        <span class="mx-2 h-4 w-px bg-ink-800"></span>
        <% for (const seconds of [15, 30, 60, 120]) { %>
        <button class="rounded-md px-3 py-1 <%= seconds === 30 ? 'text-accent' : 'text-ink-500 hover:text-ink-200' %>"><%= seconds %></button>
        <% } %>
        <span class="mx-2 h-4 w-px bg-ink-800"></span>
        <button class="rounded-md px-3 py-1 text-ink-500 hover:text-ink-200">punctuation</button>
        <button class="rounded-md px-3 py-1 text-ink-500 hover:text-ink-200">numbers</button>
    </div>

    <!-- Live stats: seconds left (with a draining bar), live wpm and accuracy -->
    <div class="hidden flex-col gap-3 md:flex">
        <div class="flex items-end justify-between font-mono">
            <div class="flex items-baseline gap-3">
                <span class="text-4xl font-bold text-accent tabular-nums">21</span>
                <span class="flex items-center gap-1.5 rounded-full border border-ink-800 px-2.5 py-0.5 text-xs text-ink-500">
                    <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                    english
                </span>
            </div>
            <div class="flex gap-6 text-sm text-ink-500">
                <span><span class="text-ink-200 tabular-nums">68</span> wpm</span>
                <span><span class="text-ink-200 tabular-nums">96%</span> acc</span>
            </div>
        </div>
        <div class="h-0.5 overflow-hidden rounded-full bg-ink-900">
            <div class="h-full w-[30%] rounded-full bg-accent transition-[width] duration-1000 ease-linear"></div>
        </div>
    </div>

    <!--
        Typing area. Each character is a <span> in one of these states:
          untyped    text-ink-600
          correct    text-ink-100
          incorrect  text-rose-500
          extra      text-rose-800 (typed past the end of a word)
        The caret is a blinking bar placed before the current character.
    -->
    <!--
        Before the test starts or when focus is lost, the text is blurred and this overlay shows.
        Add the "unfocused" class to the wrapper to see it.
    -->
    <div class="group relative hidden md:block" tabindex="0">
    <p class="pointer-events-none absolute inset-0 z-10 hidden place-items-center text-sm text-ink-300 group-[.unfocused]:grid">
        <span class="flex items-center gap-2 rounded-full border border-ink-800 bg-ink-950/80 px-4 py-2 backdrop-blur">Click here or press any key to focus</span>
    </p>
    <div class="font-mono text-2xl leading-relaxed tracking-wide transition select-none group-[.unfocused]:opacity-30 group-[.unfocused]:blur-[3px] sm:text-3xl">
        <span class="text-ink-100">the quick </span><span class="text-ink-100">br</span><span class="text-rose-500">i</span><span class="text-ink-100">wn fox jumps</span><span class="text-rose-800">s</span><span class="text-ink-100"> over th</span><span class="caret inline-block h-[1.1em] w-0.5 translate-y-1 rounded bg-accent"></span><span class="text-ink-600">e lazy dog while every keystroke is checked one character at a time so you can see exactly where your fingers slip and how your speed holds up over the full test</span>
    </div>
    </div>

    <!-- Restart -->
    <div data-hide-in-focus class="hidden flex-col items-center gap-4 md:flex">
        <button
            class="grid size-10 place-items-center rounded-md text-ink-500 hover:bg-ink-900 hover:text-ink-200 focus-visible:outline-2 focus-visible:outline-accent"
            aria-label="Restart test"
        >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                <path d="M3 3v5h5" />
            </svg>
        </button>
        <p class="flex items-center gap-1.5 text-xs text-ink-600">
            <%- include("../partials/kbd", { key: "tab" }) %> + <%- include("../partials/kbd", { key: "enter" }) %> restart
            <span class="mx-2">·</span>
            <%- include("../partials/kbd", { key: "esc" }) %> command menu
        </p>
    </div>
</main>

<%- include("../partials/footer") %>
