<%- include("../partials/head", { title: "Typing test" }) %>
<%- include("../partials/header") %>

<%
const modes = [
    { label: "time", icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/>', active: true },
    { label: "words", icon: '<path d="M4 7h16M4 12h10M4 17h13"/>' },
    { label: "quote", icon: '<path d="M7 7h4v4H8a3 3 0 0 0 3 3v2a5 5 0 0 1-5-5V8a1 1 0 0 1 1-1zm8 0h4v4h-3a3 3 0 0 0 3 3v2a5 5 0 0 1-5-5V8a1 1 0 0 1 1-1z"/>' },
    { label: "zen", icon: '<path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"/>' },
];
const extras = [
    { label: "punctuation", short: "@ !", on: false },
    { label: "numbers", short: "# 1", on: true },
];
const icon = (d, size = "size-3.5") => `<svg viewBox="0 0 24 24" class="${size}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
%>

<main id="main" class="flex flex-1 flex-col justify-center gap-8 pb-16">
    <%- include("../partials/mobile-notice") %>

    <!-- Today: streak, goal and personal best. Quiet context that hides while typing. -->
    <section data-hide-in-focus class="hidden items-center justify-center gap-3 text-xs md:flex">
        <span class="flex items-center gap-1.5 rounded-full border border-orange-500/20 bg-orange-500/5 px-3 py-1 text-orange-300">🔥 <span class="font-mono">14</span> day streak</span>
        <span class="flex items-center gap-2 rounded-full border border-ink-900 bg-ink-900/40 px-3 py-1 text-ink-400">
            <svg viewBox="0 0 36 36" class="size-3.5 -rotate-90"><circle cx="18" cy="18" r="14" fill="none" stroke="var(--ink-800)" stroke-width="6"/><circle cx="18" cy="18" r="14" fill="none" stroke="var(--accent)" stroke-width="6" pathLength="1" stroke-dasharray="0.7 1"/></svg>
            <span class="font-mono text-ink-200">7</span>/10 min today
        </span>
        <span class="flex items-center gap-1.5 rounded-full border border-ink-900 bg-ink-900/40 px-3 py-1 text-ink-400">best <span class="font-mono text-ink-200">74</span> wpm on time 30</span>
    </section>

    <!-- Mode bar -->
    <div data-hide-in-focus class="mx-auto hidden flex-wrap items-center justify-center gap-2 md:flex">
        <div class="flex items-center gap-0.5 rounded-xl border border-ink-900 bg-ink-900/60 p-1 text-sm">
            <% for (const m of modes) { %>
            <button class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 <%= m.active ? 'bg-ink-800 text-accent shadow-sm' : 'text-ink-500 hover:text-ink-200' %>"><%- icon(m.icon) %><%= m.label %></button>
            <% } %>
        </div>
        <div class="flex items-center gap-0.5 rounded-xl border border-ink-900 bg-ink-900/60 p-1 font-mono text-sm">
            <% for (const s of [15, 30, 60, 120]) { %>
            <button class="min-w-11 rounded-lg px-2.5 py-1.5 <%= s === 30 ? 'bg-ink-800 text-accent shadow-sm' : 'text-ink-500 hover:text-ink-200' %>"><%= s %></button>
            <% } %>
            <button class="rounded-lg px-2.5 py-1.5 text-ink-500 hover:text-ink-200" aria-label="Custom duration"><%- icon('<path d="M12 20h9M16.5 3.5a2.1 2.1 0 1 1 3 3L7 19l-4 1 1-4z"/>') %></button>
        </div>
        <div class="flex items-center gap-0.5 rounded-xl border border-ink-900 bg-ink-900/60 p-1 text-sm">
            <% for (const e of extras) { %>
            <button aria-pressed="<%= e.on %>" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 <%= e.on ? 'bg-ink-800 text-accent shadow-sm' : 'text-ink-500 hover:text-ink-200' %>"><span class="font-mono text-xs opacity-70"><%= e.short %></span><%= e.label %></button>
            <% } %>
        </div>
    </div>

    <!-- Test card -->
    <section class="relative hidden md:block">
        <!-- Soft glow behind the card -->
        <div class="pointer-events-none absolute inset-x-10 -inset-y-6 -z-10 rounded-[3rem] bg-accent/5 blur-3xl"></div>

        <div class="rounded-3xl border border-ink-900 bg-ink-900/30 p-8 shadow-sm">
            <!-- Live stats -->
            <div class="mb-6 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <!-- Timer ring -->
                    <div class="relative grid size-14 place-items-center">
                        <svg viewBox="0 0 36 36" class="absolute inset-0 -rotate-90">
                            <circle cx="18" cy="18" r="16" fill="none" stroke="var(--ink-800)" stroke-width="2.5" />
                            <circle cx="18" cy="18" r="16" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" pathLength="1" stroke-dasharray="0.7 1" class="transition-[stroke-dasharray] duration-1000 ease-linear" />
                        </svg>
                        <span class="font-mono text-lg font-bold text-accent tabular-nums">21</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xs text-ink-500">seconds left</span>
                        <span class="flex items-center gap-1.5 text-xs text-ink-400"><span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>english · time 30</span>
                    </div>
                </div>
                <div class="flex gap-2 font-mono">
                    <% for (const [value, label] of [["68", "wpm"], ["96%", "acc"], ["2", "errors"]]) { %>
                    <div class="flex min-w-16 flex-col items-center rounded-xl bg-ink-950/60 px-3 py-1.5">
                        <span class="text-lg font-bold text-ink-100 tabular-nums"><%= value %></span>
                        <span class="text-[10px] tracking-wider text-ink-500 uppercase"><%= label %></span>
                    </div>
                    <% } %>
                </div>
            </div>

            <!--
                Typing area. Each word is a <span>; each letter inside is coloured by state:
                  untyped    text-ink-600
                  correct    text-ink-100
                  wrong      text-rose-500 + underline
                  extra      text-rose-500/60 (typed past the end of a word)
                The current word gets a subtle background. Three lines show; the last fades out.
                Add the "unfocused" class to the wrapper to see the click-to-focus overlay.
            -->
            <div class="group relative" tabindex="0" aria-label="Typing area">
                <p class="pointer-events-none absolute inset-0 z-10 hidden place-items-center group-[.unfocused]:grid">
                    <span class="flex items-center gap-2 rounded-full border border-ink-800 bg-ink-950/90 px-4 py-2 text-sm text-ink-200 shadow-lg backdrop-blur">
                        <%- icon('<path d="M9 9l5 12 1.8-5.2L21 14z"/><path d="M7.2 2.2 8 5.1M5.1 8l-2.9-.8M14 4.1 12 6M6 12l-1.9 2"/>', "size-4") %>
                        Click or press any key to start
                    </span>
                </p>
                <%- include("../partials/typing-text") %>
            </div>
        </div>
    </section>

    <!-- Actions + hints -->
    <div data-hide-in-focus class="hidden flex-col items-center gap-5 md:flex">
        <div class="flex items-center gap-2">
            <button class="group/tip relative grid size-11 place-items-center rounded-xl border border-ink-900 text-ink-400 hover:border-ink-700 hover:bg-ink-900 hover:text-ink-100" aria-label="Restart test">
                <%- icon('<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>', "size-5 transition group-hover/tip:-rotate-90") %>
            </button>
            <button class="grid size-11 place-items-center rounded-xl border border-ink-900 text-ink-400 hover:border-ink-700 hover:bg-ink-900 hover:text-ink-100" aria-label="Next test">
                <%- icon('<path d="m9 18 6-6-6-6"/>', "size-5") %>
            </button>
            <a href="focus.html" class="grid size-11 place-items-center rounded-xl border border-ink-900 text-ink-400 hover:border-ink-700 hover:bg-ink-900 hover:text-ink-100" aria-label="Focus mode (f)">
                <%- icon('<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>', "size-5") %>
            </a>
        </div>
        <p class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-ink-600">
            <span class="flex items-center gap-1.5"><%- include("../partials/kbd", { key: "tab" }) %><%- include("../partials/kbd", { key: "enter" }) %> restart</span>
            <span class="flex items-center gap-1.5"><%- include("../partials/kbd", { key: "ctrl" }) %><%- include("../partials/kbd", { key: "k" }) %> search</span>
            <span class="flex items-center gap-1.5"><%- include("../partials/kbd", { key: "f" }) %> focus</span>
            <span class="flex items-center gap-1.5"><%- include("../partials/kbd", { key: "?" }) %> shortcuts</span>
        </p>
    </div>

    <!-- Suggestion -->
    <a data-hide-in-focus href="practice.html" class="lift mx-auto hidden max-w-md items-center gap-3 rounded-2xl border border-ink-900 bg-ink-900/30 px-4 py-3 text-sm md:flex">
        <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-rose-500/10 font-mono text-rose-400">e</span>
        <span class="flex-1 text-ink-400">You miss <span class="font-mono text-ink-100">e</span> and <span class="font-mono text-ink-100">r</span> most. A 2-minute drill helps.</span>
        <span class="text-ink-600">→</span>
    </a>
</main>

<%- include("../partials/footer") %>
