<%- include("../partials/head", { title: "Empty states" }) %>
<%- include("../partials/header") %>

<%# What each page shows before there is any data. %>

<main id="main" class="flex flex-1 flex-col gap-10 pb-16">
    <div>
        <p class="font-mono text-xs text-accent">reference</p>
        <h1 class="mt-2 text-2xl font-semibold text-ink-100">Empty states</h1>
        <p class="mt-1 text-sm text-ink-500">What a brand-new user sees on each page before they have any data.</p>
    </div>

    <% for (const [page, props] of [
        ["History", { icon: "🕘", title: "No tests yet", body: "Finish your first test and it will show up here with its speed, accuracy and chart.", action: ["Take a test", "index.html"], secondary: ["Try a drill", "practice.html"] }],
        ["Custom text library", { icon: "📚", title: "Your library is empty", body: "Save a text from the editor and it'll be here next time, with your best speed on it.", action: ["Write a text", "custom.html"], secondary: ["Import a file", "custom-import.html"] }],
        ["Leaderboard (no results this period)", { icon: "🏁", title: "Nobody's raced yet today", body: "Be the first on today's board. Results reset at 00:00 UTC.", action: ["Take a test", "index.html"] }],
        ["Profile (signed out)", { icon: "👤", title: "Sign in to keep your progress", body: "Your tests are saved in this browser. Sign in to sync them, join the leaderboard and earn achievements.", action: ["Sign in", "login.html"], secondary: ["Create account", "signup.html"] }],
        ["Search (no matches)", { icon: "🔍", title: "No commands match “zzz”", body: "Try a page name like history, or a setting like theme." }],
    ]) { %>
    <section class="flex flex-col gap-3">
        <h2 class="text-xs font-medium tracking-wider text-ink-500 uppercase"><%= page %></h2>
        <% const { icon, title, body, action, secondary } = props; %>
        <div class="flex flex-col items-center gap-4 rounded-2xl border border-dashed border-ink-800 px-6 py-14 text-center">
            <span class="grid size-14 place-items-center rounded-2xl bg-ink-900 text-2xl"><%= icon %></span>
            <div>
                <p class="font-medium text-ink-100"><%= title %></p>
                <p class="mx-auto mt-1 max-w-sm text-sm text-ink-500"><%= body %></p>
            </div>
            <% if (action) { %>
            <div class="flex gap-2">
                <a href="<%= action[1] %>" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-ink-950 hover:opacity-90"><%= action[0] %></a>
                <% if (secondary) { %><a href="<%= secondary[1] %>" class="rounded-lg border border-ink-800 px-4 py-2 text-sm text-ink-300 hover:bg-ink-900"><%= secondary[0] %></a><% } %>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>
</main>

<%- include("../partials/footer") %>
