<%- include("../partials/head", { title: "Reset password" }) %>
<%- include("../partials/auth-top", { icon: "🔒", heading: "Choose a new password", subheading: "For <span class='text-ink-300'>shihab@example.com</span>" }) %>

<form class="flex flex-col gap-4 rounded-2xl border border-ink-900 bg-ink-900/40 p-6 shadow-sm">
    <div class="flex flex-col gap-2">
        <%- include("../partials/field", { label: "New password", type: "password", placeholder: "At least 8 characters" }) %>
        <div class="flex gap-1">
            <% for (let i = 0; i < 4; i++) { %><span class="h-1 flex-1 rounded-full <%= i < 3 ? 'bg-emerald-500' : 'bg-ink-800' %>"></span><% } %>
        </div>
        <p class="text-xs text-emerald-400">Strong password</p>
    </div>
    <%- include("../partials/field", { label: "Confirm password", type: "password", placeholder: "Type it again" }) %>
    <button class="h-10 rounded-lg bg-accent text-sm font-medium text-ink-950 hover:opacity-90">Update password</button>
</form>
<p class="mt-6 text-center text-sm text-ink-500"><a href="login.html" class="text-accent hover:underline">← Back to sign in</a></p>

<%- include("../partials/auth-bottom") %>
