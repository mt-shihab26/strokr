<%- include("../partials/head", { title: "Settings" }) %>
<%- include("../partials/header") %>

<%
const groups = [
    {
        title: "Test",
        rows: [
            { label: "Default mode", hint: "What a new test starts with.", options: ["time", "words"], active: "time" },
            { label: "Duration", hint: "Seconds for time mode.", options: ["15", "30", "60", "120"], active: "30" },
            { label: "Word count", hint: "Words for words mode.", options: ["10", "25", "50", "100"], active: "50" },
            { label: "Language", hint: "Word list to draw from.", options: ["english", "english 1k", "code"], active: "english" },
        ],
    },
    {
        title: "Behaviour",
        rows: [
            { label: "Stop on error", hint: "Block the next character until a mistake is fixed.", options: ["off", "letter", "word"], active: "off" },
            { label: "Quick restart", hint: "Key that restarts the test.", options: ["tab", "esc", "off"], active: "tab" },
            { label: "Live stats", hint: "Show wpm and accuracy while typing.", options: ["on", "off"], active: "on" },
        ],
    },
    {
        title: "Appearance",
        rows: [
            { label: "Font size", hint: "Size of the typing text.", options: ["small", "medium", "large"], active: "medium" },
            { label: "Caret", hint: "Shape of the cursor.", options: ["line", "block", "underline"], active: "line" },
        ],
    },
];
%>

<main class="flex flex-1 flex-col gap-10 pb-16">
    <div>
        <h1 class="text-2xl font-semibold text-ink-100">Settings</h1>
        <p class="mt-1 text-sm text-ink-500">Saved in your browser. Changes apply to the next test.</p>
    </div>

    <!-- Toast shown for ~2s after any change. -->
    <div class="fixed right-6 bottom-6 z-40 flex items-center gap-2 rounded-lg border border-ink-800 bg-ink-900 px-4 py-2.5 text-sm text-ink-200 shadow-xl" role="status">
        <span class="grid size-4 place-items-center rounded-full bg-emerald-500 text-[10px] text-ink-950">✓</span>
        Settings saved
    </div>

    <% for (const group of groups) { %>
    <section>
        <h2 class="mb-3 text-xs font-medium tracking-wider text-ink-500 uppercase"><%= group.title %></h2>
        <div class="divide-y divide-ink-900 rounded-xl border border-ink-900">
            <% for (const row of group.rows) { %>
            <div class="flex flex-wrap items-center justify-between gap-4 p-4">
                <div>
                    <p class="text-sm text-ink-100"><%= row.label %></p>
                    <p class="text-xs text-ink-500"><%= row.hint %></p>
                </div>
                <div class="flex gap-1 rounded-lg bg-ink-900 p-1 font-mono text-sm">
                    <% for (const option of row.options) { %>
                    <button class="rounded-md px-3 py-1 <%= option === row.active ? 'bg-ink-800 text-accent' : 'text-ink-500 hover:text-ink-200' %>"><%= option %></button>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </section>
    <% } %>

    <!-- Theme picker. Each card sets its own data-theme, so it previews that theme's colours. -->
    <section>
        <h2 class="mb-3 text-xs font-medium tracking-wider text-ink-500 uppercase">Theme</h2>
        <div class="stagger grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            <% for (const name of ["system", "dark", "light", "nord", "sepia", "matrix"]) { %>
            <button data-set-theme="<%= name %>" class="flex flex-col gap-2 rounded-xl border-2 border-ink-900 p-1.5 text-left text-sm text-ink-400 hover:border-ink-700">
                <% if (name === "system") { %>
                <span class="grid h-16 grid-cols-2 overflow-hidden rounded-lg">
                    <span data-theme="light" class="bg-ink-950 p-2"><span class="block h-1.5 w-8 rounded bg-accent"></span></span>
                    <span data-theme="dark" class="bg-ink-950 p-2"><span class="block h-1.5 w-8 rounded bg-accent"></span></span>
                </span>
                <% } else { %>
                <span data-theme="<%= name %>" class="flex h-16 flex-col justify-between rounded-lg bg-ink-950 p-2 font-mono text-[10px]">
                    <span><span class="text-ink-100">the quick </span><span class="text-rose-500">b</span><span class="text-ink-600">rown fox</span></span>
                    <span class="flex gap-1"><span class="h-1.5 w-8 rounded bg-accent"></span><span class="h-1.5 w-4 rounded bg-ink-700"></span></span>
                </span>
                <% } %>
                <span class="px-1 pb-0.5"><%= name %></span>
            </button>
            <% } %>
        </div>
    </section>

    <!-- Keyboard shortcuts -->
    <section id="shortcuts" class="scroll-mt-28">
        <h2 class="mb-3 text-xs font-medium tracking-wider text-ink-500 uppercase">Keyboard shortcuts</h2>
        <div class="grid gap-px overflow-hidden rounded-xl border border-ink-900 bg-ink-900 sm:grid-cols-2">
            <% for (const [keys, action] of [
                [["tab", "enter"], "Restart test"],
                [["esc"], "Open command menu"],
                [["ctrl", "shift", "p"], "Change mode"],
                [["ctrl", "h"], "Go to history"],
                [["ctrl", ","], "Open settings"],
                [["?"], "Show all shortcuts"],
            ]) { %>
            <div class="flex items-center justify-between bg-ink-950 px-4 py-3 text-sm">
                <span class="text-ink-300"><%= action %></span>
                <span class="flex items-center gap-1">
                    <% for (const key of keys) { %><%- include("../partials/kbd", { key }) %><% } %>
                </span>
            </div>
            <% } %>
        </div>
    </section>

    <!-- Danger zone -->
    <section class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-rose-950 bg-rose-950/20 p-4">
        <div>
            <p class="text-sm text-ink-100">Clear history</p>
            <p class="text-xs text-ink-500">Deletes every saved test. This can't be undone.</p>
        </div>
        <button class="rounded-md border border-rose-900 px-4 py-2 text-sm text-rose-400 hover:bg-rose-950">Clear history</button>
    </section>
</main>

<%- include("../partials/footer") %>
