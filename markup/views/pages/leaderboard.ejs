<%- include("../partials/head", { title: "Leaderboard" }) %>
<%- include("../partials/header") %>

<%
const players = [
    ["kestrel", 168, 99.1, 412],
    ["mono_type", 161, 98.4, 1280],
    ["qwertyuiop", 155, 97.9, 96],
    ["lin.dev", 149, 98.8, 530],
    ["fastfingers", 144, 96.5, 2210],
    ["home_row", 139, 99.4, 77],
    ["nora", 136, 97.2, 341],
    ["tapdancer", 131, 98.0, 615],
    ["capslock", 127, 95.8, 204],
    ["shihab", 81, 96.0, 128],
];
const medal = ["text-amber-300", "text-ink-300", "text-orange-400"];
%>

<main id="main" class="flex flex-1 flex-col gap-8 pb-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-ink-100">Leaderboard</h1>
            <p class="mt-1 text-sm text-ink-500">Best wpm per person. Resets every Monday at 00:00 UTC.</p>
            <span class="mt-3 flex w-fit items-center gap-2 rounded-full border border-ink-900 bg-ink-900/40 px-3 py-1.5 text-xs text-ink-400">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
                </span>
                <span><span class="font-mono text-ink-200">1,284</span> people typing right now</span>
            </span>
        </div>
        <div class="flex flex-wrap gap-2">
            <div class="flex gap-1 rounded-lg bg-ink-900 p-1 font-mono text-sm">
                <% for (const [label, active] of [["time 15", false], ["time 60", true], ["words 50", false]]) { %>
                <button class="rounded-md px-3 py-1 <%= active ? 'bg-ink-800 text-accent' : 'text-ink-500 hover:text-ink-200' %>"><%= label %></button>
                <% } %>
            </div>
            <div class="flex gap-1 rounded-lg bg-ink-900 p-1 font-mono text-sm">
                <% for (const [label, active] of [["daily", false], ["weekly", true], ["all time", false]]) { %>
                <button class="rounded-md px-3 py-1 <%= active ? 'bg-ink-800 text-ink-100' : 'text-ink-500 hover:text-ink-200' %>"><%= label %></button>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Podium -->
    <section class="stagger grid items-end gap-4 sm:grid-cols-3">
        <% players.slice(0, 3).forEach(([name, wpm, acc], i) => { %>
        <div class="lift relative flex flex-col items-center rounded-2xl border bg-ink-900/40 p-6 text-center <%= i === 0 ? 'sm:order-2 border-amber-400/40 bg-gradient-to-b from-amber-400/10 to-transparent sm:pb-10' : i === 1 ? 'sm:order-1 border-ink-900' : 'sm:order-3 border-ink-900' %>">
            <% if (i === 0) { %><span class="absolute -top-3 text-xl">👑</span><% } %>
            <span class="grid size-14 place-items-center rounded-full bg-ink-800 font-mono text-lg text-ink-100 ring-2 <%= ['ring-amber-300', 'ring-ink-400', 'ring-orange-400'][i] %>"><%= name.slice(0, 2).toUpperCase() %></span>
            <a href="user.html" class="mt-3 font-medium text-ink-100 hover:text-accent"><%= name %></a>
            <p class="mt-2 font-mono text-4xl font-bold text-accent"><%= wpm %></p>
            <p class="text-xs text-ink-500">wpm · <%= acc %>% acc</p>
            <span class="mt-3 font-mono text-xs <%= medal[i] %>">#<%= i + 1 %></span>
        </div>
        <% }) %>
    </section>

    <!-- Your standing -->
    <section class="flex flex-wrap items-center gap-6 rounded-2xl border border-accent/30 bg-accent/5 p-5">
        <div>
            <p class="text-xs text-ink-500">Your rank</p>
            <p class="font-mono text-3xl font-bold text-ink-100">#214</p>
        </div>
        <div class="min-w-48 flex-1">
            <div class="mb-1.5 flex justify-between text-xs text-ink-500">
                <span>81 wpm</span>
                <span>Top 100 at 112 wpm</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-ink-900">
                <div class="bar h-full w-[72%] rounded-full bg-accent"></div>
            </div>
        </div>
        <a href="index.html" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-ink-950 hover:opacity-90">Climb the board</a>
    </section>

    <!-- Table -->
    <section class="overflow-x-auto rounded-xl border border-ink-900">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-ink-900 text-xs text-ink-500">
                <tr>
                    <th class="w-12 px-4 py-3 font-medium">#</th>
                    <th class="px-4 py-3 font-medium">name</th>
                    <th class="px-4 py-3 text-right font-medium">wpm</th>
                    <th class="px-4 py-3 text-right font-medium">accuracy</th>
                    <th class="px-4 py-3 text-right font-medium">tests</th>
                </tr>
            </thead>
            <tbody class="stagger divide-y divide-ink-900 font-mono">
                <% players.forEach(([name, wpm, acc, tests], i) => { const me = name === "shihab"; %>
                <% if (me) { %><tr><td colspan="5" class="px-4 py-1 text-center text-xs text-ink-700">⋯</td></tr><% } %>
                <tr class="<%= me ? 'bg-accent/10' : 'hover:bg-ink-900/50' %>">
                    <td class="px-4 py-3 <%= medal[i] ?? 'text-ink-500' %>"><%= me ? 214 : i + 1 %></td>
                    <td class="px-4 py-3 font-sans <%= me ? 'text-accent' : 'text-ink-100' %>"><a href="<%= me ? 'profile.html' : 'user.html' %>" class="hover:underline"><%= name %><%= me ? " (you)" : "" %></a></td>
                    <td class="px-4 py-3 text-right text-ink-100"><%= wpm %></td>
                    <td class="px-4 py-3 text-right text-ink-400"><%= acc %>%</td>
                    <td class="px-4 py-3 text-right text-ink-500"><%= tests %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </section>
</main>

<%- include("../partials/footer") %>
