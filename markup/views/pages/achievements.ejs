<%- include("../partials/head", { title: "Achievements" }) %>
<%- include("../partials/header", { page: "profile" }) %>

<%
const badges = [
    { icon: "🚀", name: "First steps", hint: "Finish your first test", done: true, date: "Nov 3" },
    { icon: "⚡", name: "60 club", hint: "Reach 60 wpm", done: true, date: "Nov 14" },
    { icon: "⚡", name: "80 club", hint: "Reach 80 wpm", done: true, date: "Nov 23" },
    { icon: "⚡", name: "100 club", hint: "Reach 100 wpm", progress: 81 },
    { icon: "🎯", name: "Sharpshooter", hint: "100% accuracy on a 30s test", done: true, date: "Nov 20" },
    { icon: "🎯", name: "Perfectionist", hint: "100% accuracy on 10 tests in a row", progress: 30 },
    { icon: "🔥", name: "On a roll", hint: "7-day streak", done: true, date: "Nov 17" },
    { icon: "🔥", name: "Unstoppable", hint: "30-day streak", progress: 47 },
    { icon: "💯", name: "Century", hint: "Finish 100 tests", done: true, date: "Nov 22" },
    { icon: "🏁", name: "First race", hint: "Finish a multiplayer race", progress: 0 },
    { icon: "🏆", name: "Podium", hint: "Top 3 on a weekly leaderboard", progress: 0, secret: false },
    { icon: "❓", name: "Secret", hint: "Keep typing to find out", progress: 0, secret: true },
];
const done = badges.filter((b) => b.done).length;
%>

<main id="main" class="flex flex-1 flex-col gap-8 pb-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <a href="profile.html" class="text-sm text-ink-500 hover:text-ink-200">← Profile</a>
            <h1 class="mt-2 text-2xl font-semibold text-ink-100">Achievements</h1>
            <p class="mt-1 text-sm text-ink-500"><%= done %> of <%= badges.length %> unlocked</p>
        </div>
        <div class="w-56">
            <div class="h-2 overflow-hidden rounded-full bg-ink-900"><div class="bar h-full rounded-full bg-accent" style="width: <%= (done / badges.length) * 100 %>%"></div></div>
        </div>
    </div>

    <section class="stagger grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% for (const b of badges) { %>
        <div class="lift flex items-center gap-4 rounded-2xl border p-4 <%= b.done ? 'border-accent/30 bg-accent/5' : 'border-ink-900 bg-ink-900/20' %>">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl text-2xl <%= b.done ? 'bg-accent/15' : 'bg-ink-900 opacity-40 grayscale' %>"><%= b.icon %></span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium <%= b.done ? 'text-ink-100' : 'text-ink-400' %>"><%= b.name %></p>
                <p class="truncate text-xs text-ink-500"><%= b.hint %></p>
                <% if (b.done) { %>
                <p class="mt-1 text-xs text-emerald-400">✓ <%= b.date %></p>
                <% } else if (!b.secret) { %>
                <div class="mt-2 h-1 overflow-hidden rounded-full bg-ink-800"><div class="bar h-full rounded-full bg-ink-500" style="width: <%= b.progress %>%"></div></div>
                <% } %>
            </div>
        </div>
        <% } %>
    </section>

    <!-- Unlock toast example -->
    <div class="fixed bottom-6 left-1/2 z-40 flex -translate-x-1/2 items-center gap-3 rounded-2xl border border-accent/40 bg-ink-900 px-4 py-3 shadow-xl" role="status">
        <span class="grid size-10 place-items-center rounded-xl bg-accent/15 text-xl">⚡</span>
        <div>
            <p class="text-xs text-accent">Achievement unlocked</p>
            <p class="text-sm font-medium text-ink-100">80 club</p>
        </div>
    </div>
</main>

<%- include("../partials/footer") %>
