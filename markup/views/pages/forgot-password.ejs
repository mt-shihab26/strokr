<%- include("../partials/head", { title: "Forgot password" }) %>
<%- include("../partials/auth-top", { icon: "🔑", heading: "Forgot your password?", subheading: "Enter your email and we'll send you a link to reset it." }) %>

<form class="flex flex-col gap-4 rounded-2xl border border-ink-900 bg-ink-900/40 p-6 shadow-sm">
    <%- include("../partials/field", { label: "Email", type: "email", placeholder: "you@example.com" }) %>
    <button class="h-10 rounded-lg bg-primary text-sm font-medium text-ink-950 hover:opacity-90">Send reset link</button>
</form>

<!-- Shown after submitting -->
<div class="mt-4 flex items-start gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 text-sm text-emerald-300">
    <span>✓</span>
    <p>If an account exists for that email, a reset link is on its way. It expires in 30 minutes.</p>
</div>

<p class="mt-6 text-center text-sm text-ink-500"><a href="login.html" class="text-primary hover:underline">← Back to sign in</a></p>

<%- include("../partials/auth-bottom") %>
