<%- include("../partials/head", { title: "Sign up" }) %>
<%- include("../partials/auth-top", { heading: "Create an account", subheading: "Keep your history across devices. Tests you've already taken come with you." }) %>

<form class="flex flex-col gap-4 rounded-2xl border border-ink-900 bg-ink-900/40 p-6 shadow-sm">
    <%- include("../partials/github-button") %>
    <%- include("../partials/field", { label: "Username", placeholder: "fastfingers" }) %>
    <%- include("../partials/field", { label: "Email", type: "email", placeholder: "you@example.com" }) %>
    <div class="flex flex-col gap-2">
        <%- include("../partials/field", { label: "Password", type: "password", placeholder: "At least 8 characters", error: "Password must be at least 8 characters." }) %>
        <!-- Strength meter: fill 1–4 bars -->
        <div class="flex gap-1">
            <% for (let i = 0; i < 4; i++) { %><span class="h-1 flex-1 rounded-full <%= i < 1 ? 'bg-rose-500' : 'bg-ink-800' %>"></span><% } %>
        </div>
    </div>
    <label class="flex items-start gap-2 text-xs text-ink-500">
        <input type="checkbox" class="mt-0.5 accent-[var(--accent)]" checked />
        Show me on the public leaderboard
    </label>
    <button class="h-10 rounded-lg bg-accent text-sm font-medium text-ink-950 hover:opacity-90">Create account</button>
    <p class="text-center text-xs text-ink-600">By signing up you agree to the <a href="terms.html" class="underline hover:text-ink-300">terms</a> and <a href="privacy.html" class="underline hover:text-ink-300">privacy policy</a>.</p>
</form>
<p class="mt-6 text-center text-sm text-ink-500">Already have one? <a href="login.html" class="text-accent hover:underline">Sign in</a></p>

<%- include("../partials/auth-bottom") %>
