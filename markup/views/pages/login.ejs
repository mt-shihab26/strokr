<%- include("../partials/head", { title: "Sign in" }) %>
<%- include("../partials/auth-top", { heading: "Welcome back", subheading: "Sign in to sync your history and join the leaderboard." }) %>

<form class="flex flex-col gap-4 rounded-2xl border border-ink-900 bg-ink-900/40 p-6 shadow-sm">
    <%- include("../partials/github-button") %>
    <%- include("../partials/field", { label: "Email", type: "email", placeholder: "you@example.com" }) %>
    <%- include("../partials/field", { label: "Password", type: "password", placeholder: "••••••••", aside: "Forgot?", asideHref: "forgot-password.html" }) %>
    <label class="flex items-center gap-2 text-xs text-ink-500">
        <input type="checkbox" class="accent-[var(--accent)]" checked />
        Keep me signed in
    </label>
    <button class="h-10 rounded-lg bg-accent text-sm font-medium text-ink-950 hover:opacity-90">Sign in</button>
</form>
<p class="mt-6 text-center text-sm text-ink-500">No account? <a href="signup.html" class="text-accent hover:underline">Sign up</a></p>

<%- include("../partials/auth-bottom") %>
