<%- include("../partials/head", { title: "Sign in" }) %>
<%- include("../partials/header") %>

<main class="flex flex-1 items-center justify-center pb-16">
    <div class="w-full max-w-sm">
        <div class="mb-8 text-center">
            <h1 class="text-2xl font-semibold text-ink-100">Welcome back</h1>
            <p class="mt-1 text-sm text-ink-500">Sign in to sync your history and join the leaderboard.</p>
        </div>
        <form class="flex flex-col gap-4 rounded-xl border border-ink-900 bg-ink-900/40 p-6">
            <button type="button" class="flex h-10 items-center justify-center gap-2 rounded-md border border-ink-800 text-sm text-ink-200 hover:bg-ink-900">
                <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg>
                Continue with GitHub
            </button>
            <div class="flex items-center gap-3 text-xs text-ink-600"><span class="h-px flex-1 bg-ink-800"></span>or<span class="h-px flex-1 bg-ink-800"></span></div>
            <%- include("../partials/field", { label: "Email", type: "email", placeholder: "you@example.com" }) %>
            <%- include("../partials/field", { label: "Password", type: "password", placeholder: "••••••••", aside: "Forgot?" }) %>
            <button class="h-10 rounded-md bg-accent text-sm font-medium text-ink-950 hover:opacity-90">Sign in</button>
        </form>
        <p class="mt-6 text-center text-sm text-ink-500">No account? <a href="signup.html" class="text-accent hover:underline">Sign up</a></p>
    </div>
</main>

<%- include("../partials/footer") %>
