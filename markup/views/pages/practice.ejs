<%- include("../partials/head", { title: "Practice" }) %>
<%- include("../partials/header") %>

<%
const lessons = [
    { title: "Home row", keys: "a s d f j k l ;", progress: 100, wpm: 72 },
    { title: "Top row", keys: "q w e r u i o p", progress: 100, wpm: 64 },
    { title: "Index fingers", keys: "r t f g v b y u h j n m", progress: 80, wpm: 58 },
    { title: "Bottom row", keys: "z x c v n m , .", progress: 45, wpm: 41 },
    { title: "Common bigrams", keys: "th he in er an re", progress: 20, wpm: 0 },
    { title: "Numbers", keys: "1 2 3 4 5 6 7 8 9 0", progress: 0, wpm: 0 },
    { title: "Punctuation", keys: ", . ; : ' \" ! ?", progress: 0, wpm: 0 },
    { title: "Weak keys", keys: "built from your mistakes", progress: 0, wpm: 0 },
];
%>

<main id="main" class="flex flex-1 flex-col gap-10 pb-16">
    <div>
        <h1 class="text-2xl font-semibold text-ink-100">Practice</h1>
        <p class="mt-1 text-sm text-ink-500">Short drills that build one group of keys at a time.</p>
    </div>

    <%- include("../partials/mobile-notice") %>

    <!-- Active drill -->
    <section class="hidden flex-col gap-8 rounded-xl border border-ink-900 bg-ink-900/40 p-6 md:flex">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="text-xs text-ink-500">Lesson 4 of 8</p>
                <h2 class="text-lg font-medium text-ink-100">Bottom row</h2>
            </div>
            <div class="flex gap-6 font-mono text-sm text-ink-500">
                <span><span class="text-ink-200">41</span> wpm</span>
                <span><span class="text-ink-200">93%</span> acc</span>
                <span><span class="text-ink-200">3/10</span> lines</span>
            </div>
        </div>

        <div class="text-center font-mono text-3xl tracking-wide select-none">
            <span class="text-ink-100">zx cv </span><span class="text-rose-500">m</span><span class="text-ink-100">n zx </span><span class="caret inline-block h-[1.1em] w-0.5 translate-y-1 rounded bg-primary"></span><span class="text-ink-600">cv bn m, ./ zxc</span>
        </div>

        <%- include("../partials/keyboard", { active: "c", fingers: true }) %>

        <p class="flex items-center justify-center gap-1.5 text-xs text-ink-600">
            Next key: <%- include("../partials/kbd", { key: "c" }) %> left middle finger
            <span class="mx-2">·</span>
            <%- include("../partials/kbd", { key: "tab" }) %> skip line
        </p>
    </section>

    <!-- Lessons -->
    <section>
        <h2 class="mb-3 text-xs font-medium tracking-wider text-ink-500 uppercase">Lessons</h2>
        <div class="stagger grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <% lessons.forEach((lesson, i) => { %>
            <a href="#" class="group flex flex-col gap-3 rounded-xl border p-4 <%= i === 3 ? 'border-primary/60 bg-primary/5' : 'border-ink-900 hover:border-ink-700' %>">
                <div class="flex items-center justify-between">
                    <span class="font-mono text-xs text-ink-500"><%= String(i + 1).padStart(2, "0") %></span>
                    <% if (lesson.progress === 100) { %><span class="text-xs text-emerald-400">done</span><% } else if (i === 3) { %><span class="text-xs text-primary">in progress</span><% } %>
                </div>
                <div>
                    <p class="text-sm font-medium text-ink-100"><%= lesson.title %></p>
                    <p class="mt-1 truncate font-mono text-xs text-ink-500"><%= lesson.keys %></p>
                </div>
                <div class="h-1 overflow-hidden rounded-full bg-ink-800">
                    <div class="bar h-full rounded-full <%= lesson.progress === 100 ? 'bg-emerald-500' : 'bg-primary' %>" style="width: <%= lesson.progress %>%"></div>
                </div>
                <p class="text-xs text-ink-600"><%= lesson.wpm ? `best ${lesson.wpm} wpm` : "not started" %></p>
            </a>
            <% }) %>
        </div>
    </section>
</main>

<%- include("../partials/footer") %>
